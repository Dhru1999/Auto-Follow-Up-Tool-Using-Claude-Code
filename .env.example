# Copy to .env (never commit .env). Used by the Python backend in backend/ only;
# the WinForms app stores its settings encrypted per Windows user instead.

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# Gmail: use an App Password (Google Account > Security > App passwords), not your normal password.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
SENDER_NAME=

# Tracker workbook managed by the backend (created on first run if missing)
EXCEL_FILE_PATH=data/job_applications.xlsx
# Optional second workbook whose Status column is synced into the tracker
EXCEL_SOURCE_PATH=

# The hourly scheduler sends real emails without review. Leave false unless you want that.
AUTO_SEND_ENABLED=false

FLASK_PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
